# Development example. Use a secret manager or deployment secrets in production.
SECRET_KEY=replace-with-a-long-random-secret
DEBUG=True
APP_ENV=development
POSTGRES_DB=django_db
POSTGRES_USER=django_user
POSTGRES_PASSWORD=replace-with-local-password
DB_HOST=localhost
DB_PORT=5432
APP_ENCRYPTION_PRIVATE_KEY_FILE=secrets/app-encryption-private.pem
APP_ENCRYPTION_KEY_ID=app-key-v1
# Keep this aligned with NEXT_PUBLIC_APP_ENCRYPTION_ENABLED in the frontend.
APP_ENCRYPTION_ENABLED=true
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:3001,http://localhost:3004,http://127.0.0.1:3004
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:3001,http://localhost:3004,http://127.0.0.1:3004
ONEDRIVE_SERVICE_KEY=replace-with-local-service-key
ONEDRIVE_TOKEN_ENCRYPTION_KEY=replace-with-fernet-key
EMAIL_HOST=localhost
EMAIL_PORT=1025
EMAIL_USE_TLS=False
EMAIL_USE_SSL=False
DEFAULT_FROM_EMAIL=soporte@example.com
FRONTEND_URL=http://localhost:3000
# MLOps: use a remote MLflow server in shared environments.
MLFLOW_TRACKING_URI=sqlite:///ml/mlflow.db
MLFLOW_EXPERIMENT=cbm-video-pipeline
MLFLOW_REQUIRED=False
MLFLOW_ARTIFACT_ROOT=ml/mlartifacts
