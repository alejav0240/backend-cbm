# Development example. Use a secret manager or deployment secrets in production.
SECRET_KEY=replace-with-a-long-random-secret
DEBUG=True
APP_ENV=development
POSTGRES_DB=django_db
POSTGRES_USER=django_user
POSTGRES_PASSWORD=replace-with-local-password
DB_HOST=localhost
DB_PORT=5432
FRONTEND_ORIGINS=http://localhost:3000
ALLOWED_HOSTS=localhost,127.0.0.1
ONEDRIVE_SERVICE_KEY=replace-with-local-service-key
ONEDRIVE_TOKEN_ENCRYPTION_KEY=replace-with-fernet-key
EMAIL_HOST=localhost
EMAIL_PORT=1025
EMAIL_USE_TLS=False
EMAIL_USE_SSL=False
DEFAULT_FROM_EMAIL=soporte@example.com
FRONTEND_URL=http://localhost:3000
